# Server settings
PORT=5000

# MongoDB Database Connection String
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/coopseva
MONGODB_URI="your_mongodb_connection_string"

# JWT Secret for securing authentication tokens
JWT_SECRET="your_jwt_secret_key"

# SMTP Settings for Nodemailer (OTP and Digital Invoices)
# If using Gmail, use smtp.gmail.com and generate an App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_email_app_password"
